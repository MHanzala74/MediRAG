# ─────────────────────────────────────────────────────────────────────
#  RAG Medical Assistant — Environment Configuration
#  Copy to .env and fill in your values. Never commit .env!
# ─────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
HOST=0.0.0.0
PORT=8000

# ── Security ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60
# Required to sign up as admin (upload docs, run evaluations). In production an
# empty value DISABLES admin signup. Choose a long random string.
ADMIN_SIGNUP_CODE=

# ── LLM Providers ────────────────────────────────────────────────────
PRIMARY_LLM=openai           # openai | groq
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings ────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai    # openai | huggingface
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG Settings ─────────────────────────────────────────────────────
CHROMA_DIR=./chroma_db
DOCS_UPLOAD_DIR=./docs_store
CHUNK_SIZE=600
CHUNK_OVERLAP=120
RETRIEVER_K=6
RERANKER_TOP_N=3
USE_HYBRID_SEARCH=true
USE_RERANKER=true
CHAT_HISTORY_LIMIT=10

# ── Guardrails ────────────────────────────────────────────────────────
ENABLE_GUARDRAILS=true

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medical_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
